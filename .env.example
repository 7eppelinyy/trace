# ==============================================================================
# Trace 生产与运维环境配置模板 (.env.example)
# ==============================================================================
# 复制本文件为 .env 并按实际生产凭据填写：
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 系统核心运行模式
# ------------------------------------------------------------------------------
# TRACE_MODE:
#   - "production": 生产真实模式，调用真实 LLM、行情与外部数据源
#   - "offline": 纯离线/测试模式，阻断外部网络，使用 Mock 与确定性规则
TRACE_MODE=production

# API 监听端口与安全密钥
PORT=8000
HOST=0.0.0.0
APP_SECRET=change-this-to-a-secure-random-token-in-production

# ------------------------------------------------------------------------------
# 2. 存储与备份配置
# ------------------------------------------------------------------------------
# SQLite 数据库文件路径 (持久化卷)
TRACE_DB_PATH=data/trace.db

# 数据库自动备份目录与保留份数
TRACE_BACKUP_DIR=data/backups
TRACE_BACKUP_KEEP=7

# ------------------------------------------------------------------------------
# 3. LLM 智能分析与调用预算
# ------------------------------------------------------------------------------
# Provider 选择: "gemini" 或 "openai"
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# OpenAI API (兼容 DeepSeek / Ollama / LocalAI 等兼容接口)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# 每日 LLM 调用成本熔断预算 (超过该调用次数停止模型处理并等待预算恢复)
LLM_DAILY_CALL_BUDGET=200

# ------------------------------------------------------------------------------
# 4. 行情数据接入 (Market Data)
# ------------------------------------------------------------------------------
# 美股 Alpaca 实时与 15 分钟历史 Bar 行情 (可选；无配置时使用 Tencent 美股行情)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

# A股与美股腾讯公共接口缓存 TTL (秒)
MARKET_QUOTE_CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Telegram 消息推送与 Bot 交互
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here
# 允许使用 /accuracy, /status 等管理命令的 Chat ID 名单 (逗号分隔)
TELEGRAM_ALLOWED_CHAT_IDS=your_chat_id_here

# ------------------------------------------------------------------------------
# 6. SEC EDGAR 合规联系信息 (必填，否则官方源会被 403 封锁)
# ------------------------------------------------------------------------------
SEC_COMPANY_NAME=TraceResearch
SEC_CONTACT_EMAIL=admin@example.com

# Only explicitly enabled local/test authentication may issue dev identities.
TRACE_ALLOW_DEV_AUTH=0
TRACE_ADMIN_USER_IDS=
TRACE_CORS_ORIGINS=
