# ---- 运行模式：test / offline / production（production 禁止伪成功） ----
TRACE_MODE=offline

# ---- Telegram ----
# 明文密钥一律不进版本库；此处仅作占位符。真实 token 在 ./.env（已被 gitignore）。
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
# run-once 验收时告警投递的默认接收人（用户自己的 chat id）
TELEGRAM_DEFAULT_CHAT_ID=<your-user-chat-id>
# 允许使用机器人的 chat id（逗号分隔），留空则不做限制（仅开发阶段）
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- LLM（可插拔 Provider，默认 Gemini；API Provider、模型、超时、重试均由环境变量控制，禁止硬编码） ----
# LLM_PROVIDER=gemini|openai（默认 gemini）
LLM_PROVIDER=gemini
# Gemini（默认 Provider，缺少 GEMINI_API_KEY 时 production 返回
# STOP_TRACE_MVP_V1_GEMINI_KEY_MISSING）
GEMINI_API_KEY=<your-gemini-api-key>
# 统一模型名（优先于 settings.yaml 与下方分项）
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
# OpenAI（保持兼容，非必需依赖；仅当 LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# ---- SEC 公平访问（User-Agent = "公司名 联系邮箱"） ----
SEC_COMPANY_NAME=TraceEventRadar
SEC_CONTACT_EMAIL=research@example.com

# ---- 行情（美股首版 Alpaca；无 Key 时降级并显式标记 mock） ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

# ---- 数据库 ----
DATABASE_PATH=data/trace.db
