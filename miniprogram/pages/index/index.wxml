<view class="page-container premium-page {{reduceMotion ? 'motion-reduced' : ''}}" style="padding-top: {{navInset}}px;">
  <view class="page-header"><view><view class="page-title">雷达</view><view class="page-subtitle">{{todayLabel}}</view></view><view class="refresh-btn btn-press" bindtap="onManualRefresh" aria-label="刷新"><text>↻</text></view></view>
  <view wx:if="{{loading && displayEvents.length === 0}}" class="skeleton-card"><view class="skeleton-block skeleton-title"></view><view class="skeleton-block"></view><view class="quiet-caption">正在加载</view></view>
  <view class="indices-strip" wx:if="{{indices.length > 0}}">
    <view class="index-cell" wx:for="{{indices}}" wx:key="code"><view class="index-name">{{item.name}}<text class="index-badge" wx:if="{{item.statusBadge}}">{{item.statusBadge}}</text></view><view class="index-price tnum {{!item.hasQuote ? 'color-neutral' : ''}}">{{item.formattedPrice}}</view><view class="index-pct tnum {{!item.hasQuote ? 'color-neutral' : (item.isUp ? 'color-up' : 'color-down')}}">{{item.formattedPct}}</view></view>
  </view>
  <view class="section-header"><text class="section-title">事件</text><text class="section-sub">最近收录</text></view>
  <view class="event-feed" wx:if="{{displayEvents.length > 0}}">
    <view class="event-item card-active" wx:for="{{displayEvents}}" wx:key="event_id" bindtap="navigateToDetail" data-id="{{item.event_id}}">
      <view class="event-meta"><text class="event-source">{{item.source}}</text><text class="event-time" wx:if="{{item.collectedTime}}">收录 {{item.collectedTime}}</text></view>
      <view class="event-title">{{item.title}}</view><view class="event-summary line-clamp-2" wx:if="{{item.summary}}">{{item.summary}}</view>
      <view class="event-footer"><view class="securities-wrap"><block wx:for="{{item.securities}}" wx:key="ticker" wx:for-item="security" wx:for-index="securityIndex"><text class="sec-chip" wx:if="{{securityIndex < 2}}">{{security.name || security.ticker}}</text></block><text class="quiet-caption" wx:if="{{item.securities.length > 2}}">+{{item.securities.length - 2}}</text></view><text class="event-chevron">›</text></view>
    </view>
  </view>
  <view class="empty-state-home" wx:if="{{!loading && displayEvents.length === 0}}"><view class="empty-title">暂无事件</view><view class="empty-desc">可以稍后刷新。</view></view>
</view>
