page {
  height: 100%;
  overflow: hidden;
}

.ask-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: #F5F5F7;
  box-sizing: border-box;
  overflow: hidden;
}

.ask-header {
  flex-shrink: 0;
  padding: 24rpx 32rpx 16rpx 32rpx;
  background-color: rgba(242, 244, 248, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.ask-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.025em;
}

.ask-subtitle {
  font-size: 22rpx;
  color: #6E6E73;
  margin-top: 6rpx;
  font-weight: 400;
}

.clear-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(15, 23, 42, 0.04);
}

.clear-icon-img {
  width: 28rpx;
  height: 28rpx;
}

/* 聊天内容滚动区 */
.chat-stream {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

/* 预设追问建议 */
.preset-section {
  margin-bottom: 32rpx;
}

.preset-label {
  font-size: 21rpx;
  font-weight: 600;
  color: #86868B;
  letter-spacing: 0.02em;
  margin-bottom: 12rpx;
}

.preset-item {
  background-color: #FFFFFF;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
  transition: background-color 80ms ease-out;
}

.preset-item:active {
  background-color: #F5F5F7;
}

.preset-text {
  font-size: 24rpx;
  color: #424245;
  font-weight: 500;
  letter-spacing: -0.01em;
}

.preset-arrow {
  color: #86868B;
  font-size: 24rpx;
}

/* 消息行 */
.msg-row {
  margin-bottom: 28rpx;
}

.user-row {
  display: flex;
  justify-content: flex-end;
}

.user-bubble {
  max-width: 82%;
  background-color: #1D1D1F;
  color: #FFFFFF;
  padding: 20rpx 28rpx;
  border-radius: 26rpx;
  border-top-right-radius: 6rpx;
  font-size: 26rpx;
  line-height: 1.5;
  letter-spacing: -0.01em;
}

.ai-row {
  display: flex;
  flex-direction: column;
}

.ai-meta {
  font-size: 20rpx;
  color: #86868B;
  margin-bottom: 8rpx;
}

.ai-card {
  background-color: #FFFFFF;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 26rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(15, 23, 42, 0.03);
}

.ai-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 10rpx;
}

.ai-content {
  font-size: 25rpx;
  color: #515154;
  line-height: 1.6;
  white-space: pre-wrap;
}

.ai-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.04);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 21rpx;
}

.ai-source {
  color: #86868B;
}

.ai-link {
  color: #007AFF;
  font-weight: 600;
}

/* 思考等待框 */
.thinking-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.thinking-spinner {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #CBD5E1;
  border-top-color: #1D1D1F;
  border-radius: 50%;
  animation: spin 800ms linear infinite;
}

.thinking-text {
  font-size: 21rpx;
  color: #86868B;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 底部常驻输入条：牢牢固定在当前可见视口底部，Tabbar 之上 */
.input-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)) 28rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 100;
  box-shadow: 0 -2rpx 10rpx rgba(15, 23, 42, 0.03);
}

.ask-input {
  flex: 1;
  background-color: rgba(15, 23, 42, 0.04);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #1D1D1F;
}

.send-btn {
  background-color: #1D1D1F;
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

/* 安全拦截特化样式 */
.ai-card-security {
  border-left: 6rpx solid #DC2626 !important;
  background-color: #FEF2F2 !important;
}

.ai-title-security {
  color: #991B1B !important;
}

.ai-content-security {
  color: #7F1D1D !important;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 降级与兜底特化样式 */
.ai-card-degraded {
  border-left: 6rpx solid #D97706 !important;
  background-color: #FFFBEB !important;
}

.ai-title-degraded {
  color: #B45309 !important;
}



/* V2: readable research conversation. */
.ask-header { padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 24rpx; border: 0; background: #F5F5F7; }
.ask-title { font-size: 60rpx; line-height: 1.2; letter-spacing: -0.04em; }
.ask-subtitle { font-size: 25rpx; color: #6E6E73; margin-top: 10rpx; }
.clear-btn { width: auto; min-width: 88rpx; min-height: 88rpx; font-size: 26rpx; background: transparent; color: #007AFF; }
.chat-stream { padding: 24rpx 40rpx; }
.welcome-title { font-size: 36rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.welcome-subtitle { font-size: 28rpx; color: #6E6E73; margin-bottom: 32rpx; line-height: 1.6; }
.preset-item { min-height: 64rpx; padding: 24rpx 28rpx; border: 0; box-shadow: none; border-radius: 24rpx; }
.preset-text { font-size: 28rpx; line-height: 1.5; }
.preset-arrow { margin-left: 16rpx; color: #007AFF; }
.msg-row { margin-bottom: 36rpx; }
.user-bubble { background: #E7E7ED; color: #1D1D1F; padding: 24rpx 28rpx; border-radius: 28rpx; font-size: 30rpx; line-height: 1.6; max-width: 86%; }
.ai-card { padding: 32rpx; border: 0; box-shadow: none; border-radius: 28rpx; animation: trace-answer-in 160ms cubic-bezier(0.23,1,0.32,1); }
.ai-meta { font-size: 24rpx; color: #6E6E73; margin: 0 0 12rpx 8rpx; }
.ai-title { font-size: 27rpx; color: #6E6E73; font-weight: 500; margin-bottom: 24rpx; }
.ai-content { display: block; font-size: 30rpx; color: #1D1D1F; line-height: 1.7; word-break: break-word; }
.answer-section + .answer-section { margin-top: 28rpx; }
.answer-kind { font-size: 24rpx; color: #6E6E73; margin-bottom: 10rpx; }
.answer-text { display: block; font-size: 30rpx; line-height: 1.75; color: #1D1D1F; word-break: break-word; }
.answer-lead { font-size: 32rpx; font-weight: 550; }
.answer-details-toggle { padding: 24rpx 0; margin-top: 12rpx; color: #007AFF; font-size: 26rpx; line-height: 1.5; }
.answer-details { background: #F5F5F7; border-radius: 20rpx; padding: 24rpx; }
.condition-group + .condition-group { margin-top: 24rpx; }
.condition-text { display: block; font-size: 27rpx; line-height: 1.65; color: #515154; white-space: pre-wrap; word-break: break-word; }
.next-checks { margin: 24rpx 0; }
.source-row { display: flex; justify-content: space-between; gap: 12rpx; padding: 20rpx 0; color: #007AFF; font-size: 26rpx; word-break: break-all; }
.ai-footer { align-items: flex-start; flex-wrap: wrap; gap: 20rpx; font-size: 24rpx; }
.ai-source { flex: 1; min-width: 160rpx; line-height: 1.5; }
.ai-link { padding: 12rpx 0; font-size: 25rpx; }
.graph-action { margin-top: 8rpx; }
.input-bar { background: #FFFFFF; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-color: #E5E5EA; gap: 20rpx; box-shadow: none; }
.ask-input { min-width: 0; font-size: 30rpx; padding: 22rpx; border-radius: 28rpx; height: 48rpx; }
.send-btn { background: #007AFF; padding: 28rpx 24rpx; font-size: 28rpx; border-radius: 24rpx; }
.thinking-text { font-size: 27rpx; color: #6E6E73; }
.thinking-spinner { border-top-color: #007AFF; }
.retry-answer { color: #007AFF; padding: 22rpx 0; font-size: 28rpx; }
.control-disabled { opacity: 0.45; }
.new-answer-hint { padding: 18rpx 32rpx; text-align: center; color: #007AFF; background: #E7EEFC; font-size: 26rpx; }
.ai-card-security, .ai-card-degraded { border-left: 0 !important; }
