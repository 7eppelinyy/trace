<view class="ask-container premium-page {{reduceMotion ? 'motion-reduced' : ''}} {{keyboardVisible ? 'keyboard-open' : ''}}">
  <view class="ask-header" style="padding-top: {{navInset}}px;">
    <view><view class="brand-kicker">TRACE RESEARCH</view><view class="ask-title">推演</view></view>
    <view class="clear-btn btn-press {{thinking ? 'control-disabled' : ''}}" bindtap="clearChat" aria-label="清空对话，开始新对话"><text>新对话</text></view>
  </view>
  <scroll-view class="chat-stream" scroll-y scroll-into-view="{{scrollTarget}}" bindscroll="onChatScroll" enable-flex>
    <view class="preset-section" wx:if="{{messages.length === 0}}">
      <view class="research-intro"><view class="research-symbol" aria-hidden="true">T</view><view class="welcome-title">让判断，有所依据。</view><view class="welcome-subtitle"><view>从业务逻辑出发，</view><view>把事实、条件与假设分开。</view></view></view>
      <view class="preset-item" bindtap="askPreset" data-query="美光和闪迪的业务有什么区别，DRAM和NAND涨价分别对谁更有利？"><view><view class="preset-category">业务比较</view><text class="preset-text">美光与闪迪，有什么不同？</text></view><text class="preset-arrow">↗</text></view>
      <view class="preset-item" bindtap="askPreset" data-query="假设AI服务器需求放缓，光模块和液冷产业链会受到什么影响？"><view><view class="preset-category">情景假设</view><text class="preset-text">AI 需求放缓，会影响哪些环节？</text></view><text class="preset-arrow">↗</text></view>
      <view class="preset-item" bindtap="askPreset" data-query="假设美联储降息，美股科技公司的估值会受到什么影响？"><view><view class="preset-category">宏观机制</view><text class="preset-text">降息如何影响科技股估值？</text></view><text class="preset-arrow">↗</text></view>
    </view>
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-row user-row" wx:if="{{item.role === 'user'}}" id="msg-{{item.id}}"><view class="user-bubble"><text selectable>{{item.content}}</text></view></view>
      <view class="msg-row ai-row" wx:if="{{item.role === 'assistant'}}" id="msg-{{item.id}}">
        <view class="ai-meta"><view class="answer-monogram">T</view><text>{{item.metaBadge}}</text></view>
        <view class="ai-card {{item.isSecurity ? 'ai-card-security' : (item.isDegraded ? 'ai-card-degraded' : '')}}">
          <view class="ai-title">{{item.title}}</view>
          <block wx:if="{{item.answerClaims && item.answerClaims.length > 0}}">
            <view class="answer-section" wx:for="{{item.answerClaims}}" wx:key="id" wx:for-item="claim" wx:for-index="claimIndex"><view class="answer-kind"><text class="answer-number">{{claimIndex < 9 ? '0' + (claimIndex + 1) : claimIndex + 1}}</text>{{claimIndex === 0 ? '核心回答' : claim.label}}</view><text class="answer-text {{claimIndex === 0 ? 'answer-lead' : ''}}" selectable>{{claim.text}}</text></view>
          </block>
          <text wx:else class="ai-content" selectable>{{item.content}}</text>
          <view class="answer-details-toggle" wx:if="{{item.hasAnswerDetails}}" bindtap="toggleAnswerDetails" data-index="{{index}}">{{item.detailsExpanded ? '收起条件与来源 −' : '查看成立条件与资料来源 ＋'}}</view>
          <view class="answer-details" wx:if="{{item.detailsExpanded}}">
            <block wx:for="{{item.answerClaims}}" wx:key="id" wx:for-item="claim" wx:for-index="claimIndex">
              <view class="condition-group" wx:if="{{claim.conditions.length > 0 || claim.supportQuote || claim.counterEvidence.length > 0}}">
                <view class="answer-kind">第 {{claimIndex + 1}} 项 · 条件与支持</view>
                <view class="condition-text" wx:for="{{claim.conditions}}" wx:key="*this" wx:for-item="condition">· {{condition}}</view>
                <text class="condition-text" wx:if="{{claim.supportQuote}}" selectable>支持片段：{{claim.supportQuote}}</text>
                <view class="condition-text" wx:for="{{claim.counterEvidence}}" wx:key="*this" wx:for-item="counter">反证条件：{{counter}}</view>
              </view>
            </block>
            <text class="condition-text next-checks" wx:if="{{item.nextChecksText}}" selectable>{{item.nextChecksText}}</text>
            <view class="answer-kind" wx:if="{{item.answerSources.length > 0}}">资料来源 · 点击复制链接</view>
            <view class="source-row" wx:for="{{item.answerSources}}" wx:key="url" wx:for-item="source" bindtap="copySource" data-url="{{source.url}}"><text>{{source.number}}. {{source.label}}</text><text>↗</text></view>
          </view>
          <view class="ai-footer"><text class="ai-source">{{item.sourceLabel}}</text><view class="ai-link" bindtap="copyAnswer" data-index="{{index}}">复制回答</view></view>
          <view class="ai-link graph-action" wx:if="{{!item.isSecurity && item.graphChain && item.graphChain.length > 0}}" bindtap="navigateToDetail" data-index="{{index}}">查看关联路径 →</view>
          <view class="retry-answer btn-press" wx:if="{{item.canRetry}}" bindtap="retryAsk" data-index="{{index}}" data-query="{{item.retryQuery}}">重新尝试</view>
        </view>
      </view>
    </block>
    <view class="msg-row ai-row" wx:if="{{thinking}}" id="msg-thinking"><view class="thinking-box"><view class="thinking-spinner"></view><text class="thinking-text">正在生成回答{{elapsedSeconds > 0 ? ' · ' + elapsedSeconds + ' 秒' : ''}}</text></view><view class="quiet-caption">复杂问题可能需要更长时间</view></view>
    <view id="scroll-bottom" style="height: 24rpx;"></view>
  </scroll-view>
  <view class="new-answer-hint" wx:if="{{showNewAnswerHint}}" bindtap="jumpToLatest">新回答已就绪 · 向下查看 ↓</view>
  <view class="input-bar"><input class="ask-input" placeholder="写下你的研究问题…" value="{{inputValue}}" bindinput="onInput" bindconfirm="submitAsk" bindkeyboardheightchange="onKeyboardChange" confirm-type="send" adjust-position="{{true}}" cursor-spacing="24" maxlength="1000" /><view class="send-btn btn-press {{thinking ? 'control-disabled' : ''}}" bindtap="submitAsk" aria-label="{{thinking ? '等待回答' : '发送问题'}}">{{thinking ? '···' : '↑'}}</view></view>
</view>
