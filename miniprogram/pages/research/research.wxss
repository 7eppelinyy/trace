page { background: #F5F5F7; color: #1D1D1F; }
.research { padding: 32rpx 32rpx 100rpx; }
.heading { font-size: 48rpx; font-weight: 650; margin-bottom: 14rpx; }
.secondary { font-size: 25rpx; line-height: 1.6; color: #526174; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0; }
.actions button { margin: 0; }
.row, .editor { background: #fff; padding: 28rpx; border-radius: 20rpx; margin-top: 20rpx; }
.title { font-size: 31rpx; font-weight: 550; line-height: 1.5; margin-bottom: 12rpx; }
.label { display: block; margin: 26rpx 0 14rpx; font-size: 27rpx; font-weight: 550; }
input, textarea { box-sizing: border-box; width: 100%; min-height: 80rpx; padding: 16rpx; background: #EFEFF4; border-radius: 12rpx; font-size: 29rpx; line-height: 1.6; }
.error { color: #9F1239; background: #FFF1F2; padding: 20rpx; margin: 20rpx 0; border-radius: 12rpx; }
.link { padding: 24rpx 0; color: #1D4ED8; font-size: 28rpx; }
.evidence { font-family: monospace; font-size: 22rpx; margin-top: 8rpx; overflow-wrap: anywhere; }
.empty { padding: 38rpx 0; color: #526174; }
.sharing { border-top: 1rpx solid #E2E8F0; padding-top: 24rpx; margin-top: 24rpx; }
button { font-size: 28rpx; }


/* V2: calm private research notebook. */
.research { padding: 32rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.heading { font-size: 52rpx; letter-spacing: -0.03em; font-weight: 650; }
.secondary { font-size: 27rpx; color: #6E6E73; line-height: 1.7; }
.row, .editor { border-radius: 28rpx; padding: 32rpx; border: 0; }
.row:active { background: #EDEDF2; }
.title { font-size: 32rpx; }
.label { font-size: 28rpx; }
input, textarea { border-radius: 20rpx; padding: 24rpx; font-size: 30rpx; }
button { border-radius: 22rpx; font-size: 28rpx; background: #E7EEFC; color: #007AFF; }
button::after { border: 0; }
.editor > button { background: #007AFF; color: #FFFFFF; margin-top: 28rpx; }
.evidence { word-break: break-all; }
