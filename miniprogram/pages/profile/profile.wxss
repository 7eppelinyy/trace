/** pages/profile/profile.wxss **/

.account-card {
  background-color: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
}

.avatar-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #1D1D1F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.account-info {
  flex: 1;
}

.account-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1D1D1F;
}

.account-id {
  font-size: 22rpx;
  color: #86868B;
  margin-top: 6rpx;
}

.status-badge {
  background-color: #ECFDF5;
  color: #059669;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

/* 分组标题 */
.group-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #86868B;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
}

.setting-desc {
  font-size: 22rpx;
  color: #86868B;
  margin-top: 4rpx;
}

.param-label {
  font-size: 26rpx;
  color: #515154;
}

.param-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #1D1D1F;
}

/* Apple 极简物理 Switch */
.apple-switch {
  width: 64rpx;
  height: 36rpx;
  border-radius: 9999rpx;
  padding: 4rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  transition: background-color 200ms ease;
}

.switch-on {
  background-color: #1D1D1F;
  justify-content: flex-end;
}

.switch-off {
  background-color: #CBD5E1;
  justify-content: flex-start;
}

.switch-dot {
  width: 28rpx;
  height: 28rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.2);
}

/* 工具操作按钮 */
.action-btn-wrap {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tool-btn {
  background-color: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #424245;
}

.tool-btn.btn-primary {
  background-color: #1D1D1F;
  color: #FFFFFF;
  border-color: #1D1D1F;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.15);
}

.status-badge.status-online {
  background-color: #ECFDF5;
  color: #059669;
}

.status-badge.status-offline {
  background-color: #FEF2F2;
  color: #DC2626;
}

/* 免责声明合规区域 */
.disclaimer-wrap {
  margin-top: 48rpx;
  margin-bottom: 40rpx;
  padding: 24rpx;
  text-align: center;
}

.disclaimer-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6E6E73;
  margin-bottom: 12rpx;
}

.disclaimer-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #86868B;
  text-align: justify;
}


/* V2: personal preferences with technical controls folded away. */
.account-card { border: 0; box-shadow: none; gap: 24rpx; padding: 32rpx; flex-wrap: wrap; }
.avatar-badge { background: #E3EDFF; color: #007AFF; font-size: 36rpx; font-weight: 650; }
.account-info { min-width: 220rpx; }
.account-name { font-size: 32rpx; font-weight: 600; }
.account-id { font-size: 25rpx; line-height: 1.5; }
.status-badge { border-radius: 999rpx; font-size: 24rpx; padding: 10rpx 18rpx; }
.group-title { color: #6E6E73; font-size: 25rpx; font-weight: 400; letter-spacing: 0; padding-left: 24rpx; margin: 28rpx 0 14rpx; }
.flex-between { gap: 24rpx; align-items: center; }
.setting-copy { flex: 1; min-width: 0; }
.setting-name { font-size: 30rpx; font-weight: 500; }
.setting-desc { color: #6E6E73; font-size: 25rpx; line-height: 1.6; }
.param-val { font-size: 26rpx; flex-shrink: 0; }
.row-chevron { color: #86868B; font-size: 36rpx; }
.advanced-settings { padding: 0 32rpx 24rpx; }
.advanced-description { color: #6E6E73; font-size: 24rpx; line-height: 1.7; word-break: break-all; margin: 12rpx 0 20rpx; }
.tool-btn { background: transparent; border-radius: 0; border: 0; border-top: 1rpx solid #E5E5EA; text-align: left; box-shadow: none; color: #007AFF; font-size: 28rpx; padding: 28rpx 0; margin: 0; }
.destructive-tool { color: #C9342B; }
.switch-hit-area { min-height: 88rpx; min-width: 100rpx; display: flex; align-items: center; justify-content: flex-end; }
.switch-on { background-color: #34C759; }
.switch-off { background-color: #E5E5EA; }
.disclaimer-wrap { margin-top: 32rpx; padding: 0 16rpx; }
.disclaimer-title { font-size: 24rpx; font-weight: 500; color: #6E6E73; }
.disclaimer-text { font-size: 24rpx; line-height: 1.7; color: #6E6E73; }
