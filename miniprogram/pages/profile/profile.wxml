<view class="page-container premium-page {{reduceMotion ? 'motion-reduced' : ''}}" style="padding-top: {{navInset}}px;">
  <view class="page-header"><view><view class="brand-kicker">YOUR RESEARCH SPACE</view><view class="page-title">我的</view><view class="page-subtitle">为研究，留一点空间。</view></view></view>
  <view class="account-card"><view class="avatar-badge">T</view><view class="account-info"><view class="account-name">设备访客账户</view><view class="account-id">当前设备的独立研究空间</view></view><view class="status-badge {{isOnline ? 'status-online' : 'status-offline'}}">{{isOnline ? '在线' : '离线'}}</view></view>
  <view class="group-title">研究</view>
  <view class="apple-group"><view class="apple-cell flex-between card-active" bindtap="openResearch"><view><view class="setting-name">我的研究</view><view class="setting-desc">记录假设，跟踪新证据</view></view><text class="row-chevron">›</text></view></view>
  <view class="group-title">提醒偏好</view>
  <view class="apple-group">
    <view class="apple-cell flex-between"><view class="setting-copy"><view class="setting-name">重大事件提醒</view><view class="setting-desc">综合评分 ≥ {{alertThreshold || '7.0'}}</view></view><view class="switch-hit-area" bindtap="toggleGlobalAlert"><view class="apple-switch {{globalEnabled ? 'switch-on' : 'switch-off'}}"><view class="switch-dot"></view></view></view></view>
    <view class="apple-cell flex-between"><view class="setting-copy"><view class="setting-name">免打扰时间</view><view class="setting-desc">使用账户设置的当地时间</view></view><text class="param-val tnum">{{quietStart || '22:00'}}–{{quietEnd || '08:00'}}</text></view>
    <view class="apple-cell"><view class="setting-name">微信外部消息</view><view class="setting-desc">目前尚未开放，以上偏好不会开启微信订阅消息。</view></view>
  </view>
  <view class="group-title">显示与反馈</view>
  <view class="apple-group"><view class="apple-cell flex-between"><view class="setting-copy"><view class="setting-name">减少动态效果</view><view class="setting-desc">减少位移、弹跳与过渡</view></view><switch color="#007AFF" checked="{{reduceMotion}}" bindchange="onReduceMotionChange" /></view></view>
  <view class="apple-group"><view class="apple-cell flex-between card-active" bindtap="toggleAdvanced"><view class="setting-name">高级设置</view><text class="row-chevron">{{showAdvanced ? '−' : '＋'}}</text></view>
    <view wx:if="{{showAdvanced}}" class="advanced-settings">
      <view class="advanced-description">设备账户：{{userIdDisplay || '未建立会话'}}<view>连接：{{apiBaseDisplay}}</view></view>
      <view class="tool-btn touch-press" bindtap="checkServer">检查服务连接</view>
      <view class="tool-btn touch-press" bindtap="toggleEndpointQuick" wx:if="{{isDev}}">切换开发通道</view>
      <view class="tool-btn touch-press" bindtap="editApiBase" wx:if="{{isDev}}">自定义服务地址</view>
      <view class="tool-btn touch-press" bindtap="handleResetWatchlist">恢复默认自选</view>
      <view class="tool-btn touch-press" bindtap="clearCache">清理临时缓存 · {{cacheSize}} KB</view>
      <view class="tool-btn touch-press destructive-tool" bindtap="handleResetSession">重置设备访客账户</view>
      <view class="advanced-description">重置将创建独立的新账户，原有个人数据不会自动迁移。</view>
    </view>
  </view>
  <view class="disclaimer-wrap"><view class="disclaimer-title">研究参考 · 独立判断</view><view class="disclaimer-text">本小程序展示的事件、行情、图谱与推演仅供研究参考，不构成投资建议、买卖依据或收益保证。市场有风险，请独立核验与决策。</view></view>
</view>
