/** pages/watchlist/watchlist.wxss - Refined Apple Stocks UI **/

/* 市场分段切换器 (Apple 经典浅灰药丸) */
.segmented-control {
  background-color: rgba(15, 23, 42, 0.05);
  padding: 6rpx;
  border-radius: 20rpx;
  display: flex;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #6E6E73;
  font-weight: 500;
  border-radius: 16rpx;
  transition: color 160ms ease-out;
  letter-spacing: -0.01em;
}

.seg-item.active {
  background-color: #FFFFFF;
  color: #1D1D1F;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* 空状态卡片 */
.empty-state {
  background-color: #FFFFFF;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 28rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(15, 23, 42, 0.02);
}

.empty-vector {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #F5F5F7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx auto;
}

.empty-vector-img {
  width: 48rpx;
  height: 48rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.empty-desc {
  font-size: 23rpx;
  color: #86868B;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-flex;
  padding: 16rpx 44rpx;
}

.clear-text-btn {
  font-size: 24rpx;
  color: #6E6E73;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background-color: rgba(15, 23, 42, 0.04);
}

.btn-secondary {
  background-color: rgba(15, 23, 42, 0.06);
  color: #1D1D1F;
  font-weight: 600;
  border-radius: 20rpx;
}

/* 左滑容器与动作按钮 */
.swipe-row {
  position: relative;
  overflow: hidden;
  background-color: #F5F5F7;
}

.swipe-actions {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 240rpx;
  display: flex;
  z-index: 1;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #FFFFFF;
  transition: opacity 100ms ease;
}

.action-btn:active {
  opacity: 0.85;
}

.pin-btn {
  background-color: #424245;
}

.del-btn {
  background-color: #DC2626;
}

.swipe-content {
  position: relative;
  z-index: 2;
  background-color: #FFFFFF;
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* 标的 Cell 内部排版 */
.ticker-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticker-info {
  flex: 1;
  min-width: 0;
}

.ticker-headline {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ticker-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.02em;
}

.ticker-name {
  font-size: 23rpx;
  color: #86868B;
  font-weight: 400;
}

.ticker-note {
  font-size: 22rpx;
  color: #6E6E73;
  margin-top: 6rpx;
  font-weight: 400;
}

/* 趋势 Sparkline */
.ticker-spark {
  padding: 0 16rpx;
  display: flex;
  align-items: center;
}

.spark-img {
  width: 140rpx;
  height: 32rpx;
}

/* 右侧报价 */
.ticker-quote {
  text-align: right;
}

.ticker-price {
  font-size: 29rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.ticker-pct {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 下方监控与推送条 */
.ticker-monitor {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.04);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #86868B;
}

.monitor-threshold {
  font-size: 21rpx;
  color: #86868B;
}

.monitor-switch-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch-label {
  font-size: 20rpx;
  color: #86868B;
}

/* Apple 极简物理 Switch */
.apple-switch {
  width: 62rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  padding: 3rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  transition: background-color 180ms ease;
}

.switch-on {
  background-color: #1D1D1F;
  justify-content: flex-end;
}

.switch-off {
  background-color: #CBD5E1;
  justify-content: flex-start;
}

.switch-dot {
  width: 28rpx;
  height: 28rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.15);
}

/* 搜索抽屉浮层 (Apple Stocks 优雅底抽) */
.search-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.4);
  backdrop-filter: blur(8px);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.search-sheet {
  background-color: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  max-height: 80vh;
  min-height: 60vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)) 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.08);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #EFEFF4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6E6E73;
}

.search-input-box {
  display: flex;
  align-items: center;
  background-color: #EFEFF4;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.search-icon-img {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1D1D1F;
}

.search-clear {
  padding: 8rpx;
  font-size: 24rpx;
  color: #86868B;
}

.suggest-label {
  font-size: 21rpx;
  font-weight: 600;
  color: #86868B;
  margin-bottom: 16rpx;
}

.suggest-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.suggest-chip {
  background-color: #F5F5F7;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 14rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #424245;
}

.search-results-list {
  flex: 1;
  overflow-y: auto;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.04);
}

.search-item-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.search-item-ticker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-item-ticker {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.search-market-pill {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background-color: #E2E8F0;
  color: #515154;
}

.search-item-name {
  font-size: 22rpx;
  color: #6E6E73;
}

.search-item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-item-quote {
  text-align: right;
}

.search-item-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.search-item-pct {
  font-size: 21rpx;
  font-weight: 600;
  margin-top: 2rpx;
}

.add-action-btn {
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  background-color: #1D1D1F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-action-btn.watched {
  background-color: #EFEFF4;
  color: #86868B;
}



/* V2: compact Stocks-style rows and a responsive selection plate. */
.watchlist-search { padding: 22rpx 28rpx; border-radius: 24rpx; background: #EAEAF0; margin-bottom: 24rpx; }
.watchlist-search input { height: 48rpx; font-size: 29rpx; }
.segmented-control { position: relative; padding: 6rpx; background: #E8E8ED; }
.segment-indicator { position: absolute; left: 6rpx; top: 6rpx; bottom: 6rpx; width: calc((100% - 12rpx) / 3); background: #FFFFFF; border-radius: 16rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06); transition: transform 200ms cubic-bezier(0.23,1,0.32,1); }
.seg-item { position: relative; z-index: 1; padding: 20rpx 0; font-size: 26rpx; transition: color 160ms ease-out; }
.seg-item.active { background: transparent; box-shadow: none; }
.clear-text-btn { min-height: 48rpx; display: flex; align-items: center; padding: 16rpx 8rpx; font-size: 26rpx; background: transparent; color: #007AFF; }
.ticker-code { font-size: 33rpx; font-weight: 650; }
.ticker-name { font-size: 27rpx; }
.ticker-headline { flex-wrap: wrap; gap: 10rpx; }
.ticker-price { font-size: 32rpx; }
.ticker-pct { font-size: 26rpx; }
.ticker-note { font-size: 24rpx; }
.ticker-monitor { flex-wrap: wrap; gap: 16rpx; }
.monitor-threshold, .switch-label { font-size: 24rpx; }
.swipe-content.is-dragging { transition: none; }
.swipe-actions { opacity: 0; }
.swipe-actions.actions-visible { opacity: 1; }
.monitor-switch-wrap { min-height: 88rpx; }
.switch-on { background-color: #34C759; }
.switch-off { background-color: #E5E5EA; }
.search-mask { backdrop-filter: none; transition: opacity 200ms ease-out; }
.search-sheet { border-radius: 40rpx 40rpx 0 0; padding: 20rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); animation: trace-sheet-in 260ms cubic-bezier(0.32,0.72,0,1); transition: transform 200ms ease-out; }
.sheet-closing { opacity: 0; }
.sheet-closing .search-sheet { transform: translateY(48rpx); }
.sheet-handle { width: 72rpx; height: 8rpx; background: #D1D1D6; border-radius: 8rpx; margin: 0 auto 30rpx; }
.sheet-title { font-size: 40rpx; }
.sheet-close { width: 88rpx; height: 88rpx; }
.search-input { min-width: 0; font-size: 29rpx; }
.search-input-box { padding: 24rpx; }
.search-item { gap: 20rpx; flex-wrap: wrap; }
.search-item-left { min-width: 0; flex: 1; }
.search-item-name { font-size: 27rpx; }
.empty-desc { color: #6E6E73; font-size: 26rpx; line-height: 1.6; }
