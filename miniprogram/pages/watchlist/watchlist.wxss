/** pages/watchlist/watchlist.wxss - Refined Apple Stocks UI **/

/* 市场分段切换器 (Apple 经典浅灰药丸) */
.segmented-control {
  background-color: rgba(15, 23, 42, 0.05);
  padding: 6rpx;
  border-radius: 20rpx;
  display: flex;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
  border-radius: 16rpx;
  transition: all 180ms ease;
  letter-spacing: -0.01em;
}

.seg-item.active {
  background-color: #FFFFFF;
  color: #0F172A;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* 空状态卡片 */
.empty-state {
  background-color: #FFFFFF;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 28rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(15, 23, 42, 0.02);
}

.empty-vector {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx auto;
}

.empty-vector-img {
  width: 48rpx;
  height: 48rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.empty-desc {
  font-size: 23rpx;
  color: #94A3B8;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-flex;
  padding: 16rpx 44rpx;
}

.clear-text-btn {
  font-size: 24rpx;
  color: #64748B;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background-color: rgba(15, 23, 42, 0.04);
}

.btn-secondary {
  background-color: rgba(15, 23, 42, 0.06);
  color: #0F172A;
  font-weight: 600;
  border-radius: 20rpx;
}

/* 左滑容器与动作按钮 */
.swipe-row {
  position: relative;
  overflow: hidden;
  background-color: #F8FAFC;
}

.swipe-actions {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 240rpx;
  display: flex;
  z-index: 1;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #FFFFFF;
  transition: opacity 100ms ease;
}

.action-btn:active {
  opacity: 0.85;
}

.pin-btn {
  background-color: #334155;
}

.del-btn {
  background-color: #DC2626;
}

.swipe-content {
  position: relative;
  z-index: 2;
  background-color: #FFFFFF;
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* 标的 Cell 内部排版 */
.ticker-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticker-info {
  flex: 1;
  min-width: 0;
}

.ticker-headline {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ticker-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.02em;
}

.ticker-name {
  font-size: 23rpx;
  color: #94A3B8;
  font-weight: 400;
}

.ticker-note {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  font-weight: 400;
}

/* 趋势 Sparkline */
.ticker-spark {
  padding: 0 16rpx;
  display: flex;
  align-items: center;
}

.spark-img {
  width: 140rpx;
  height: 32rpx;
}

/* 右侧报价 */
.ticker-quote {
  text-align: right;
}

.ticker-price {
  font-size: 29rpx;
  font-weight: 700;
  color: #0F172A;
}

.ticker-pct {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 下方监控与推送条 */
.ticker-monitor {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.04);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #94A3B8;
}

.monitor-threshold {
  font-size: 21rpx;
  color: #94A3B8;
}

.monitor-switch-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch-label {
  font-size: 20rpx;
  color: #94A3B8;
}

/* Apple 极简物理 Switch */
.apple-switch {
  width: 62rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  padding: 3rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  transition: background-color 180ms ease;
}

.switch-on {
  background-color: #0F172A;
  justify-content: flex-end;
}

.switch-off {
  background-color: #CBD5E1;
  justify-content: flex-start;
}

.switch-dot {
  width: 28rpx;
  height: 28rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.15);
}

/* 搜索抽屉浮层 (Apple Stocks 优雅底抽) */
.search-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.4);
  backdrop-filter: blur(8px);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.search-sheet {
  background-color: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  max-height: 80vh;
  min-height: 60vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)) 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.08);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #64748B;
}

.search-input-box {
  display: flex;
  align-items: center;
  background-color: #F1F5F9;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.search-icon-img {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0F172A;
}

.search-clear {
  padding: 8rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

.suggest-label {
  font-size: 21rpx;
  font-weight: 600;
  color: #94A3B8;
  margin-bottom: 16rpx;
}

.suggest-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.suggest-chip {
  background-color: #F8FAFC;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 14rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #334155;
}

.search-results-list {
  flex: 1;
  overflow-y: auto;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.04);
}

.search-item-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.search-item-ticker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-item-ticker {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.search-market-pill {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background-color: #E2E8F0;
  color: #475569;
}

.search-item-name {
  font-size: 22rpx;
  color: #64748B;
}

.search-item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-item-quote {
  text-align: right;
}

.search-item-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}

.search-item-pct {
  font-size: 21rpx;
  font-weight: 600;
  margin-top: 2rpx;
}

.add-action-btn {
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  background-color: #0F172A;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-action-btn.watched {
  background-color: #F1F5F9;
  color: #94A3B8;
}

