/* V4: native-style information hierarchy. No promotional surfaces. */
.premium-page.page-container { padding: 0 36rpx calc(164rpx + env(safe-area-inset-bottom)); }
.premium-page .page-header { padding: 16rpx 0 28rpx; }
.premium-page .page-title, .premium-page .ask-title { font-size: 64rpx; font-weight: 650; letter-spacing: -0.035em; line-height: 1.2; color: #1D1D1F; }
.premium-page .page-subtitle { font-size: 26rpx; color: #6E6E73; margin-top: 8rpx; }
.premium-page .refresh-btn { width: 88rpx; height: 88rpx; background: transparent; border: 0; box-shadow: none; color: #007AFF; font-size: 40rpx; }
.premium-page .indices-strip { display: grid; grid-template-columns: 1fr 1fr; padding: 12rpx; margin-bottom: 28rpx; gap: 0; background: #FFFFFF; border: 0; border-radius: 22rpx; box-shadow: none; }
.premium-page .index-cell { padding: 22rpx; background: transparent; border-radius: 0; border: 0; box-shadow: none; }
.premium-page .index-name { font-size: 24rpx; color: #6E6E73; }
.premium-page .index-price { font-size: 38rpx; font-weight: 550; color: #1D1D1F; letter-spacing: -0.025em; margin: 6rpx 0; }
.premium-page .index-price.color-neutral { color: #86868B; }
.premium-page .index-pct { font-size: 25rpx; font-weight: 400; }
.premium-page .section-header { margin: 32rpx 0 4rpx; }
.premium-page .section-title { font-size: 36rpx; letter-spacing: -0.02em; font-weight: 650; }
.premium-page .section-sub { font-size: 12px; color: #86868B; }
.premium-page .event-feed { background: transparent; }
.premium-page .event-item { padding: 28rpx 0; border-bottom: 1rpx solid #DDDDE2; }
.premium-page .event-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 12rpx; }
.premium-page .event-source, .premium-page .event-time { font-size: 12px; color: #6E6E73; }
.premium-page .event-time { text-align: right; }
.premium-page .event-title { font-size: 33rpx; font-weight: 550; line-height: 1.5; color: #1D1D1F; }
.premium-page .event-summary { font-size: 28rpx; line-height: 1.6; color: #6E6E73; margin-top: 12rpx; }
.premium-page .event-footer { margin-top: 14rpx; gap: 16rpx; }
.premium-page .sec-chip { font-size: 24rpx; color: #6E6E73; background: transparent; padding: 0; line-height: 1.5; }
.premium-page .securities-wrap { flex-wrap: wrap; }
.premium-page .event-chevron { font-size: 34rpx; color: #AEAEB2; }
.premium-page .apple-group { box-shadow: none; border: 0; border-radius: 22rpx; }
.premium-page .ask-header { padding-left: 36rpx; padding-right: 36rpx; padding-bottom: 24rpx; background: #F5F5F7; }
.premium-page .clear-btn { background: transparent; color: #007AFF; font-size: 27rpx; min-height: 88rpx; }
.premium-page .chat-stream { padding: 16rpx 36rpx; }
.premium-page .welcome-title { font-size: 34rpx; font-weight: 550; margin: 24rpx 0; }
.premium-page .suggestion-group { background: #FFFFFF; border-radius: 22rpx; overflow: hidden; }
.premium-page .preset-item { padding: 30rpx; margin: 0; min-height: 88rpx; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.premium-page .preset-item + .preset-item { border-top: 1rpx solid #E5E5EA; }
.premium-page .preset-text { font-size: 28rpx; font-weight: 400; color: #1D1D1F; }
.premium-page .preset-arrow { color: #AEAEB2; background: transparent; font-size: 32rpx; padding-left: 16rpx; }
.premium-page .user-bubble { color: #1D1D1F; background: #E6E6EB; border-radius: 24rpx; box-shadow: none; font-size: 29rpx; }
.premium-page .ai-card { background: transparent; box-shadow: none; border: 0; border-radius: 0; padding: 4rpx 0 28rpx; }
.premium-page .ai-meta { color: #86868B; font-size: 12px; margin: 0 0 16rpx; }
.premium-page .ai-title { color: #6E6E73; font-size: 26rpx; font-weight: 400; margin-bottom: 26rpx; }
.premium-page .answer-kind { color: #86868B; font-size: 12px; margin-bottom: 12rpx; }
.premium-page .answer-text { font-size: 30rpx; font-weight: 400; color: #1D1D1F; line-height: 1.75; }
.premium-page .answer-section + .answer-section { margin-top: 28rpx; }
.premium-page .answer-details { background: #FFFFFF; border-radius: 20rpx; border: 0; }
.premium-page .answer-details-toggle, .premium-page .ai-link { color: #007AFF; }
.premium-page .input-bar { background: #F5F5F7; border: 0; box-shadow: none; padding: 16rpx 32rpx calc(144rpx + env(safe-area-inset-bottom)); }
.premium-page.keyboard-open .input-bar { padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.premium-page .ask-input { box-sizing: border-box; height: 88rpx; min-height: 44px; padding: 20rpx 26rpx; border-radius: 24rpx; background: #FFFFFF; border: 1rpx solid #E5E5EA; box-shadow: none; font-size: 28rpx; }
.premium-page .send-btn { min-width: 44px; min-height: 44px; width: 88rpx; height: 88rpx; padding: 0; border-radius: 50%; background: #007AFF; box-shadow: none; display: flex; align-items: center; justify-content: center; }
.premium-page .account-card, .premium-page .detail-summary { background: #FFFFFF; color: #1D1D1F; border: 0; box-shadow: none; border-radius: 22rpx; }
.premium-page .account-name { color: #1D1D1F; font-size: 32rpx; font-weight: 550; }
.premium-page .account-id { color: #6E6E73; font-size: 25rpx; }
.premium-page .account-info { min-width: 180rpx; }
.premium-page .group-title { padding-left: 16rpx; font-size: 25rpx; font-weight: 400; color: #6E6E73; letter-spacing: 0; }
.premium-page .detail-summary .fact-title { font-size: 40rpx; color: #1D1D1F; }
.premium-page .detail-summary .fact-summary { color: #6E6E73; }
.premium-page .detail-card { border: 0; box-shadow: none; border-radius: 22rpx; }
.premium-page .row, .premium-page .editor { border: 0; box-shadow: none; border-radius: 22rpx; }
