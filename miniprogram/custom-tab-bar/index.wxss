.floating-tabbar { position: fixed; left: 36rpx; right: 36rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); z-index: 1000; }
.tabbar-shell { position: relative; display: flex; padding: 10rpx; background: rgba(255,255,255,0.94); border: 1rpx solid rgba(255,255,255,0.9); border-radius: 48rpx; box-shadow: 0 12rpx 44rpx rgba(28,34,45,0.12), 0 2rpx 4rpx rgba(28,34,45,0.04); }
@supports (backdrop-filter: blur(1px)) { .tabbar-shell { background: rgba(255,255,255,0.78); backdrop-filter: blur(24px) saturate(150%); } }
.tabbar-selection { position: absolute; top: 10rpx; bottom: 10rpx; left: 10rpx; width: calc((100% - 20rpx) / 4); border-radius: 36rpx; background: rgba(27,34,45,0.075); transition: transform 220ms cubic-bezier(0.23,1,0.32,1); }
.tabbar-item { position: relative; flex: 1; min-width: 0; min-height: 44px; height: 96rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 6rpx; color: #797D85; }
.tabbar-icon { width: 38rpx; height: 38rpx; opacity: 0.65; transition: opacity 120ms ease-out, transform 120ms ease-out; }
.tabbar-label { font-size: 11px; line-height: 1.3; letter-spacing: 0.01em; }
.tabbar-selected { color: #1B222D; font-weight: 600; }
.tabbar-selected .tabbar-icon { opacity: 1; }
.tabbar-item:active .tabbar-icon { transform: scale(0.94); }
.motion-reduced view, .motion-reduced image { transition: none !important; }
@media (prefers-reduced-motion: reduce) { view, image { transition: none !important; } }
