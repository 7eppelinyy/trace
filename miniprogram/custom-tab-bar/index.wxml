<view class="floating-tabbar {{reduceMotion ? 'motion-reduced' : ''}}" wx:if="{{!keyboardHidden && !overlayHidden}}">
  <view class="tabbar-shell">
    <view class="tabbar-selection" style="transform: translateX({{selected * 100}}%);"></view>
    <view class="tabbar-item {{selected === index ? 'tabbar-selected' : ''}}" wx:for="{{tabs}}" wx:key="path" bindtap="switchTab" data-index="{{index}}" role="button" aria-label="{{item.text}}" aria-current="{{selected === index}}">
      <image class="tabbar-icon" src="{{selected === index ? item.active : item.icon}}"></image>
      <text class="tabbar-label">{{item.text}}</text>
    </view>
  </view>
</view>
