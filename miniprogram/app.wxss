/** app.wxss - Apple Design System & Quiet Craftsmanship **/

page {
  --trace-background: #F5F5F7;
  --trace-surface: #FFFFFF;
  --trace-text: #1D1D1F;
  --trace-secondary: #6E6E73;
  --trace-blue: #007AFF;
  background-color: #F5F5F7;
  color: #1D1D1F;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 等宽数字排印规范（防止行情跳动） */
.tnum {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* 页面通用内边距 */
.page-container {
  padding: 24rpx 32rpx calc(140rpx + env(safe-area-inset-bottom)) 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部 Header */
.page-header {
  padding: 16rpx 0 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.025em;
  line-height: 1.1;
}

.page-subtitle {
  font-size: 23rpx;
  color: #6E6E73;
  margin-top: 8rpx;
  font-weight: 400;
  letter-spacing: -0.01em;
}

/* Apple Inset Group 一体式无缝分组列表 (无厚重边框，靠背景明暗自然分层) */
.apple-group {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 4rpx 20rpx -2rpx rgba(15, 23, 42, 0.03);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.apple-cell {
  padding: 28rpx 32rpx;
  position: relative;
  background-color: #FFFFFF;
  transition: background-color 80ms ease-out;
}

.apple-cell:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: rgba(15, 23, 42, 0.04);
}

/* 列表行与卡片点击反馈：仅背景微高亮，绝不全卡片缩放缩微！ */
.apple-cell:active, .card-active:active {
  background-color: #F5F5F7 !important;
}

/* 仅针对独立小按钮的微弱物理按压（禁止大面积卡片缩放） */
.btn-press {
  transition: transform 100ms ease-out, opacity 100ms ease-out;
}

.btn-press:active {
  transform: scale(0.98);
  opacity: 0.94;
}

/* 权威沉稳的金融涨跌配色 (Apple Stocks 调色盘) */
.color-up {
  color: #16A34A;
}

.color-down {
  color: #DC2626;
}

.bg-up {
  background-color: rgba(22, 163, 74, 0.08);
}

.bg-down {
  background-color: rgba(220, 38, 38, 0.08);
}

/* 极简深色主按钮 */
.btn-primary {
  background-color: #1D1D1F;
  color: #FFFFFF;
  border-radius: 9999rpx;
  padding: 14rpx 32rpx;
  font-size: 25rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

/* 极简浅灰次级按钮 */
.btn-secondary {
  background-color: rgba(15, 23, 42, 0.05);
  color: #424245;
  border-radius: 9999rpx;
  padding: 14rpx 28rpx;
  font-size: 25rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

/* 截断辅助类 */
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* V2 shared typography, surfaces and motion. */
page { background-color: var(--trace-background); color: var(--trace-text); line-height: 1.6; }
.page-container { padding: 20rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.page-header { padding: 24rpx 0 36rpx; align-items: center; gap: 24rpx; }
.page-header > view:first-child { min-width: 0; }
.page-title { font-size: 60rpx; font-weight: 700; letter-spacing: -0.04em; color: var(--trace-text); line-height: 1.2; }
.page-subtitle { font-size: 25rpx; color: var(--trace-secondary); margin-top: 10rpx; line-height: 1.5; }
.apple-group { border: 0; box-shadow: none; border-radius: 28rpx; margin-bottom: 32rpx; }
.apple-cell { padding: 32rpx; }
.apple-cell:active, .card-active:active { background-color: #F2F2F7 !important; }
.btn-primary { background: var(--trace-blue); padding: 20rpx 28rpx; min-height: 44rpx; font-size: 28rpx; border-radius: 22rpx; }
.btn-secondary { padding: 20rpx 28rpx; font-size: 28rpx; }
.btn-press, .touch-press { transition: transform 120ms cubic-bezier(0.23,1,0.32,1), opacity 120ms ease-out; }
.btn-press:active, .touch-press:active { transform: scale(0.98); opacity: 0.9; }
.color-neutral { color: var(--trace-secondary); }
.skeleton-block { height: 28rpx; background: #E8E8ED; border-radius: 12rpx; margin: 18rpx 0; }
.skeleton-card { background: var(--trace-surface); border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; }
.skeleton-title { width: 72%; height: 40rpx; }
.quiet-caption { color: var(--trace-secondary); font-size: 24rpx; line-height: 1.5; }
.motion-reduced view, .motion-reduced button, .motion-reduced text { animation: none !important; transition-duration: 0ms !important; }
@media (prefers-reduced-motion: reduce) {
  view, button, text { animation: none !important; transition-duration: 0ms !important; }
}
@keyframes trace-sheet-in { from { opacity: 0; transform: translateY(32rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes trace-answer-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
